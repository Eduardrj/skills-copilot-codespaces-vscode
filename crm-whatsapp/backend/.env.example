# Configurações do Servidor
PORT=3001
NODE_ENV=development

# Configurações da Evolution API
# IMPORTANTE: Em produção, sempre use HTTPS para segurança
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_api_aqui
EVOLUTION_INSTANCE_NAME=crm-whatsapp

# Configurações do Banco de Dados
DATABASE_URL="file:./dev.db"

# Configurações do Frontend
FRONTEND_URL=http://localhost:3000

# Configurações de Localização (para formatação de datas)
# Valores: pt-BR, en-US, es-ES, etc.
LOCALE=pt-BR
